# Supabase Configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Production Domain & Auth Allowed Origin
VITE_SITE_URL=

# Contact Email Dispatch Configuration (SMTP)
# Messages submitted via the contact form route to CONTACT_DESTINATION_EMAIL
CONTACT_DESTINATION_EMAIL=studio@gideonboadi.com

# Standard SMTP configuration for outgoing emails (e.g. Gmail, SendGrid, Resend, Brevo, AWS SES)
# If left blank, inquiries are safely stored in your studio database (Inquiries dashboard)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Deon Studios" <studio@gideonboadi.com>

# Server-only (Vercel env vars). NEVER prefix with VITE_ and never commit a real value.
# Needed by /api/admin/users to create/remove team members.
SUPABASE_SERVICE_ROLE_KEY=
