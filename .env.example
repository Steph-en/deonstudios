# Standard SMTP configuration for outgoing emails (e.g. Gmail, SendGrid, Resend, Brevo, AWS SES)
# If left blank, inquiries are safely stored in your studio database (Inquiries dashboard)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
