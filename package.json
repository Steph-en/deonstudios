{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:kill": "npx -y kill-port 3000 && tsx server.ts",
    "dev:3001": "PORT=3001 tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build && tsx scripts/generate-sitemap.ts",
    "generate:sitemap": "tsx scripts/generate-sitemap.ts",
    "preview": "vite preview --port=3000 --host",
    "clean": "rm -rf dist server.js",
    "optimize:storage": "tsx scripts/optimize-supabase-storage.ts --dry-run",
    "optimize:storage:apply": "tsx scripts/optimize-supabase-storage.ts --apply --backup --confirm-project-ref oorbvpnuivsyfxftlqwr",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/query-sync-storage-persister": "^5.104.5",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-query-persist-client": "^5.104.5",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "gsap": "^3.15.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.0.16",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.88.0",
    "recharts": "^3.10.1",
    "sharp": "^0.35.5",
    "tsx": "^4.21.0",
    "vite": "^6.2.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2"
  }
}
